{
  "name": "throttle-tech",
  "version": "1.0.0",
  "description": "Throttle Tech — AI shop assistant for motorcycle repair shops (web, desktop, and PWA mobile).",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "node server/index.js",
    "dev": "concurrently -k -n SERVER,WEB -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "build": "vite build",
    "start": "node server/index.js",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently -k -n SERVER,ELECTRON -c blue,magenta \"npm run dev:server\" \"electron .\"",
    "electron:build": "npm run build && electron-builder",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.throttletech.app",
    "productName": "Throttle Tech",
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "data/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": { "target": "dmg", "icon": "public/icons/icon-512.png" },
    "win": { "target": "nsis", "icon": "public/icons/icon-512.png" },
    "linux": { "target": "AppImage", "icon": "public/icons/icon-512.png" }
  }
}
